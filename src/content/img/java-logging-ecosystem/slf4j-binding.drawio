        </mxCell>
        <mxCell id="e_q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="q1" target="sl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_q2" value="각자 다른 이름의 클래스를 등록 파일로 선언" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="q2" target="sl">
