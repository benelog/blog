        <mxCell id="q2" value="log4j-slf4j2-impl&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;SLF4JServiceProvider&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="822" y="340" width="145" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="slf4j-test 3.x (valfirst)&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;테스트 의존성&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="994" y="340" width="145" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="둘 이상 있으면 경고를 내고 목록의 첫 번째를 사용. 2.0.9부터는 slf4j.provider 시스템 프로퍼티로 직접 지정할 수 있다." style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="510" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_lf2_sl" value="표준 API로 provider 목록 조회" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lf2" target="sl">
