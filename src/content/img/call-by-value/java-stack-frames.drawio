<mxfile host="app.diagrams.net">
  <diagram id="java-stack-frames" name="Java stack frames">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" page="1" pageWidth="900" pageHeight="540">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 구역 -->
        <mxCell id="stack" value="JVM stack (main 스레드)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fafafa;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="440" height="460" as="geometry" />
        </mxCell>
        <mxCell id="heap" value="Heap" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fafafa;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="20" width="320" height="460" as="geometry" />
        </mxCell>

        <!-- reassign 프레임 -->
        <mxCell id="f2" value="reassign 메서드의 프레임 (현재 프레임)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="f2lbl" value="지역 변수 배열" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="92" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t0i" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="tv" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- main 프레임 -->
        <mxCell id="f1" value="main 메서드의 프레임 (호출한 쪽)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f1lbl" value="지역 변수 배열" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="332" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="m0i" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m0" value="args" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="360" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m1i" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="myTv" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- 객체 -->
        <mxCell id="rock" value="Tv 객체&lt;br&gt;channel = &quot;Rock&quot;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="classic" value="Tv 객체&lt;br&gt;channel = &quot;Classic&quot;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="390" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- 간선 -->
        <mxCell id="e_copy" value="① 참조값 복사" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontColor=#6c8ebf;strokeColor=#6c8ebf;dashed=1;strokeWidth=1.5;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="m1" target="t0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="408" />
              <mxPoint x="340" y="245" />
              <mxPoint x="190" y="245" />
            </Array>
            <mxPoint as="offset" x="0" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_old" value="재할당 전" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontColor=#999999;strokeColor=#b3b3b3;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="t0" target="classic">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="152" />
              <mxPoint x="500" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_new" value="② tv = new Tv()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#d79b00;fontColor=#b46504;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t0" target="rock">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_mytv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=1.5;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.6667;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="classic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 설명 -->
        <mxCell id="note" value="static 메서드는 지역 변수 0번부터 파라미터를 채웁니다(JVMS §2.6.1). 두 프레임의 칸은 서로 다른 변수입니다." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="840" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
