        <mxCell id="e10" value="로그·아티팩트 업로드" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_runner" target="n_blob">
